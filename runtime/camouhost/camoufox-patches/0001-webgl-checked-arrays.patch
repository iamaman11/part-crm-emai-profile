+// A configured WebGL array is profile-stable identity material. It must
+// either be represented exactly or make the launch fail; returning the real
+// host value on malformed input would expose a host fingerprint.
+template <typename T, size_t N>
+inline std::array<T, N> MParamGL(uint32_t pname, std::array<T, N> defaultValue,
+                                 bool isWebGL2) {
+  auto value = MaskConfig::GetNested(
+      isWebGL2 ? "webGl2:parameters" : "webGl:parameters",
+      std::to_string(pname));
+  if (!value.has_value()) {
+    return defaultValue;
+  }
+
+  const auto& raw = value.value();
+  MOZ_RELEASE_ASSERT(raw.is_array() && raw.size() == N,
+                     "Camoufox WebGL array config has invalid shape");
+  std::array<T, N> result{};
+  for (size_t index = 0; index < N; ++index) {
+    const auto& item = raw[index];
+    if constexpr (std::is_same_v<T, bool>) {
+      MOZ_RELEASE_ASSERT(item.is_boolean(),
+                         "Camoufox WebGL boolean array config is invalid");
+      result[index] = item.get<bool>();
+    } else if constexpr (std::is_integral_v<T>) {
+      MOZ_RELEASE_ASSERT(item.is_number_integer() || item.is_number_unsigned(),
+                         "Camoufox WebGL integer array config is invalid");
+      if (item.is_number_unsigned()) {
+        const auto number = item.get<uint64_t>();
+        MOZ_RELEASE_ASSERT(number <=
+                               static_cast<uint64_t>(std::numeric_limits<T>::max()),
+                           "Camoufox WebGL integer array config is out of range");
+        result[index] = static_cast<T>(number);
+      } else {
+        const auto number = item.get<int64_t>();
+        MOZ_RELEASE_ASSERT(number >= static_cast<int64_t>(std::numeric_limits<T>::min()) &&
+                               number <= static_cast<int64_t>(std::numeric_limits<T>::max()),
+                           "Camoufox WebGL integer array config is out of range");
+        result[index] = static_cast<T>(number);
+      }
+    } else {
+      MOZ_RELEASE_ASSERT(item.is_number(),
+                         "Camoufox WebGL float array config is invalid");
+      const auto number = item.get<double>();
+      MOZ_RELEASE_ASSERT(std::isfinite(number) &&
+                             number >= -static_cast<double>(std::numeric_limits<T>::max()) &&
+                             number <= static_cast<double>(std::numeric_limits<T>::max()),
+                         "Camoufox WebGL float array config is out of range");
+      result[index] = static_cast<T>(number);
+    }
+  }
+  return result;
+}
