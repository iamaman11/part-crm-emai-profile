{
  "components": {
    "schemas": {
      "ActorSession": {
        "additionalProperties": false,
        "properties": {
          "actorId": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/MembershipRole"
          },
          "tenantId": {
            "type": "string"
          }
        },
        "required": [
          "tenantId",
          "actorId",
          "role"
        ],
        "type": "object"
      },
      "ClientCreateRequest": {
        "properties": {
          "clientId": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ClientKind"
          },
          "requestDigest": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "clientId",
          "kind",
          "displayName",
          "requestDigest"
        ],
        "type": "object"
      },
      "ClientGrantRequest": {
        "properties": {
          "expectedClientVersion": {
            "format": "uint64",
            "minimum": 1,
            "type": "integer"
          },
          "reason": {
            "type": "string"
          },
          "requestDigest": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/ClientGrantRole"
          }
        },
        "required": [
          "role",
          "reason",
          "expectedClientVersion",
          "requestDigest"
        ],
        "type": "object"
      },
      "ClientGrantRole": {
        "enum": [
          "CLIENT_VIEWER",
          "CLIENT_EDITOR"
        ],
        "type": "string"
      },
      "ClientKind": {
        "enum": [
          "PERSON",
          "ORGANIZATION"
        ],
        "type": "string"
      },
      "ClientProjection": {
        "additionalProperties": false,
        "properties": {
          "clientId": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ClientKind"
          },
          "status": {
            "$ref": "#/components/schemas/ClientStatus"
          },
          "version": {
            "format": "uint64",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "clientId",
          "kind",
          "displayName",
          "status",
          "version"
        ],
        "type": "object"
      },
      "ClientStatus": {
        "enum": [
          "ACTIVE",
          "ARCHIVED",
          "MERGED"
        ],
        "type": "string"
      },
      "MembershipRole": {
        "enum": [
          "TENANT_OWNER",
          "MEMBER"
        ],
        "type": "string"
      },
      "MutationReceipt": {
        "additionalProperties": false,
        "properties": {
          "aggregateVersion": {
            "format": "uint64",
            "minimum": 1,
            "type": "integer"
          },
          "resourceId": {
            "type": "string"
          },
          "resultCode": {
            "type": "string"
          }
        },
        "required": [
          "resultCode",
          "resourceId",
          "aggregateVersion"
        ],
        "type": "object"
      },
      "ProblemCode": {
        "enum": [
          "not_found",
          "forbidden",
          "invalid_request",
          "invalid_state",
          "version_conflict",
          "lease_conflict",
          "replay_rejected",
          "dependency_unavailable",
          "integrity_failure",
          "internal_failure",
          "conflict"
        ],
        "type": "string"
      },
      "ProblemPayload": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ProblemCode"
          },
          "correlation_id": {
            "type": "string"
          },
          "status": {
            "format": "uint16",
            "maximum": 599,
            "minimum": 400,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "correlation_id"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Part CRM Control Plane Public API",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/v1/session": {
      "get": {
        "operationId": "getSession",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActorSession"
                }
              }
            },
            "description": "Successful response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemPayload"
                }
              }
            },
            "description": "Problem response"
          }
        }
      }
    },
    "/api/v1/tenants/{tenantId}/clients": {
      "post": {
        "operationId": "createClient",
        "parameters": [
          {
            "in": "path",
            "name": "tenantId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MutationReceipt"
                }
              }
            },
            "description": "Successful response"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MutationReceipt"
                }
              }
            },
            "description": "Successful response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemPayload"
                }
              }
            },
            "description": "Problem response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemPayload"
                }
              }
            },
            "description": "Problem response"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemPayload"
                }
              }
            },
            "description": "Problem response"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemPayload"
                }
              }
            },
            "description": "Problem response"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemPayload"
                }
              }
            },
            "description": "Problem response"
          }
        }
      }
    },
    "/api/v1/tenants/{tenantId}/clients/{clientId}": {
      "get": {
        "operationId": "getClient",
        "parameters": [
          {
            "in": "path",
            "name": "tenantId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "clientId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientProjection"
                }
              }
            },
            "description": "Successful response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemPayload"
                }
              }
            },
            "description": "Problem response"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemPayload"
                }
              }
            },
            "description": "Problem response"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemPayload"
                }
              }
            },
            "description": "Problem response"
          }
        }
      }
    },
    "/api/v1/tenants/{tenantId}/clients/{clientId}/grants/{actorId}": {
      "delete": {
        "operationId": "revokeClientGrant",
        "parameters": [
          {
            "in": "path",
            "name": "tenantId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "clientId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "actorId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientGrantRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Grant revoked"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemPayload"
                }
              }
            },
            "description": "Problem response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemPayload"
                }
              }
            },
            "description": "Problem response"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemPayload"
                }
              }
            },
            "description": "Problem response"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemPayload"
                }
              }
            },
            "description": "Problem response"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemPayload"
                }
              }
            },
            "description": "Problem response"
          }
        }
      },
      "put": {
        "operationId": "setClientGrant",
        "parameters": [
          {
            "in": "path",
            "name": "tenantId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "clientId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "actorId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientGrantRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MutationReceipt"
                }
              }
            },
            "description": "Successful response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemPayload"
                }
              }
            },
            "description": "Problem response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemPayload"
                }
              }
            },
            "description": "Problem response"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemPayload"
                }
              }
            },
            "description": "Problem response"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemPayload"
                }
              }
            },
            "description": "Problem response"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemPayload"
                }
              }
            },
            "description": "Problem response"
          }
        }
      }
    }
  }
}
