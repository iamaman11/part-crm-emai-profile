{
  "components": {
    "schemas": {
      "ActorSession": {
        "additionalProperties": false,
        "properties": {
          "actorId": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/MembershipRole"
          },
          "tenantId": {
            "type": "string"
          }
        },
        "required": [
          "tenantId",
          "actorId",
          "role"
        ],
        "type": "object"
      },
      "ClientCreateRequest": {
        "properties": {
          "clientId": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ClientKind"
          },
          "requestDigest": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "clientId",
          "kind",
          "displayName",
          "requestDigest"
        ],
        "type": "object"
      },
      "ClientGrantRequest": {
        "properties": {
          "expectedClientVersion": {
            "format": "uint64",
            "minimum": 1,
            "type": "integer"
          },
          "reason": {
            "type": "string"
          },
          "requestDigest": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/ClientGrantRole"
          }
        },
        "required": [
          "role",
          "reason",
          "expectedClientVersion",
          "requestDigest"
        ],
        "type": "object"
      },
      "ClientGrantRole": {
        "enum": [
          "CLIENT_VIEWER",
          "CLIENT_EDITOR"
        ],
        "type": "string"
      },
      "ClientKind": {
        "enum": [
          "PERSON",
          "ORGANIZATION"
        ],
        "type": "string"
      },
      "ClientProjection": {
        "additionalProperties": false,
        "properties": {
          "clientId": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ClientKind"
          },
          "status": {
            "$ref": "#/components/schemas/ClientStatus"
          },
          "version": {
            "format": "uint64",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "clientId",
          "kind",
          "displayName",
          "status",
          "version"
        ],
        "type": "object"
      },
      "ClientStatus": {
        "enum": [
          "ACTIVE",
          "ARCHIVED",
          "MERGED"
        ],
        "type": "string"
      },
      "MembershipRole": {
        "enum": [
          "TENANT_OWNER",
          "MEMBER"
        ],
        "type": "string"
      },
      "MutationReceipt": {
        "additionalProperties": false,
        "properties": {
          "aggregateVersion": {
            "format": "uint64",
            "minimum": 1,
            "type": "integer"
          },
          "resourceId": {
            "type": "string"
          },
          "resultCode": {
            "type": "string"
          }
        },
        "required": [
          "resultCode",
          "resourceId",
          "aggregateVersion"
        ],
        "type": "object"
      },
      "NotificationCatchUpAckRequest": {
        "additionalProperties": false,
        "properties": {
          "eventId": {
            "type": "string"
          }
        },
        "required": [
          "eventId"
        ],
        "type": "object"
      },
      "NotificationCatchUpProjection": {
        "additionalProperties": false,
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/NotificationEventProjection"
            },
            "maxItems": 200,
            "type": "array"
          }
        },
        "required": [
          "events"
        ],
        "type": "object"
      },
      "NotificationEventProjection": {
        "additionalProperties": false,
        "properties": {
          "aggregateId": {
            "type": "string"
          },
          "aggregateType": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "eventType": {
            "type": "string"
          },
          "occurredAtMs": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "eventId",
          "aggregateType",
          "aggregateId",
          "eventType",
          "occurredAtMs"
        ],
        "type": "object"
      },
      "NotificationOperationsProjection": {
        "additionalProperties": false,
        "properties": {
          "catchUpLagCount": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "deadLetterCount": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "deliveredCount": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "maxAttemptCount": {
            "format": "uint16",
            "maximum": 64,
            "minimum": 0,
            "type": "integer"
          },
          "oldestOpenAgeMs": {
            "format": "uint64",
            "minimum": 0,
            "nullable": true,
            "type": "integer"
          },
          "pendingReplayCount": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "readyCount": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "retryScheduledCount": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "readyCount",
          "retryScheduledCount",
          "deliveredCount",
          "deadLetterCount",
          "pendingReplayCount",
          "maxAttemptCount",
          "oldestOpenAgeMs",
          "catchUpLagCount"
        ],
        "type": "object"
      },
      "NotificationReplayReason": {
        "enum": [
          "DEPENDENCY_RECOVERED",
          "OPERATOR_REMEDIATION",
          "INTEGRITY_REVALIDATED"
        ],
        "type": "string"
      },
      "NotificationReplayReceipt": {
        "additionalProperties": false,
        "properties": {
          "replayId": {
            "type": "string"
          },
          "resultCode": {
            "enum": [
              "prepared",
              "duplicate"
            ],
            "type": "string"
          }
        },
        "required": [
          "replayId",
          "resultCode"
        ],
        "type": "object"
      },
      "NotificationReplayRequest": {
        "additionalProperties": false,
        "properties": {
          "auditEventId": {
            "type": "string"
          },
          "consumerId": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "reasonClass": {
            "$ref": "#/components/schemas/NotificationReplayReason"
          },
          "replayId": {
            "type": "string"
          }
        },
        "required": [
          "replayId",
          "consumerId",
          "eventId",
          "auditEventId",
          "reasonClass"
        ],
        "type": "object"
      },
      "ProblemCode": {
        "enum": [
          "not_found",
          "forbidden",
          "invalid_request",
          "invalid_state",
          "version_conflict",
          "lease_conflict",
          "replay_rejected",
          "dependency_unavailable",
          "integrity_failure",
          "internal_failure",
          "conflict"
        ],
        "type": "string"
      },
      "ProblemPayload": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ProblemCode"
          },
          "correlation_id": {
            "type": "string"
          },
          "status": {
            "format": "uint16",
            "maximum": 599,
            "minimum": 400,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "correlation_id"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Part CRM Control Plane Public API",
