{
  "schema_version": 1,
  "kind": "AR11_ADDITIVE_CREDENTIAL_CAPABILITY_EXTENSION",
  "parent_authority": "architecture/credential-authority-ar8b.json",
  "implementation_issue": 421,
  "tracker_issue": 399,
  "metadata_only": true,
  "competing_registry": false,
  "production_mutation": false,
  "credentials": [
    {
      "id": "cloudflare.staging-observation-api",
      "class": "READ_ONLY_OPERATIONAL_API_CREDENTIAL",
      "provider_system": "CLOUDFLARE",
      "environment_scope": {
        "kind": "environment",
        "environments": [
          "staging"
        ]
      },
      "owner": "ar11-fc6-release-set-promotion",
      "consumers": [
        ".github/workflows/release-set-promotion.yml",
        ".github/workflows/github-governance-gate.yml"
      ],
      "bindings": [
        {
          "surface": "github_environment_secret",
          "name": "CLOUDFLARE_OBSERVE_API_TOKEN",
          "environments": [
            "staging"
          ],
          "required_usage": true
        }
      ],
      "allowed_mutator": "NONE",
      "mutation_allowed": false,
      "provider_mutation_forbidden": true,
      "protected_value_authority": "GitHub staging Environment secret store backed by externally issued Cloudflare API token",
      "legitimate_mutable_authority": "external Cloudflare token issuance plus write-only GitHub staging Environment binding ceremony",
      "exposure_boundary": "Accepted-main protected staging observe/preflight/post-verify and hosted readiness jobs only; pull_request, production and mutation-job exposure are forbidden.",
      "externally_issued": true,
      "plaintext_readback": false,
      "required_provider_permissions": [
        "Workers Scripts Read",
        "D1 Read",
        "Workers R2 Storage Read",
        "Queues Read"
      ],
      "forbidden_provider_permission_classes": [
        "Workers Scripts Edit",
        "Workers Scripts Write",
        "D1 Edit",
        "D1 Write",
        "Workers R2 Storage Edit",
        "Workers R2 Storage Write",
        "Queues Edit",
        "Queues Write",
        "API Tokens Edit",
        "API Tokens Write"
      ],
      "resource_scope": "exact staging Cloudflare account referenced by CLOUDFLARE_DEPLOY_MANIFEST_JSON; no production account or zone scope",
      "runtime_verification": {
        "token_status": "GET /user/tokens/verify => active",
        "required_read_calls": [
          "GET /accounts/{account_id}/workers/scripts/{worker_name}/deployments",
          "Wrangler D1 SELECT-only remote migration ledger read",
          "Wrangler R2 bucket info",
          "Wrangler Queues info",
          "Wrangler Worker secret-name list"
        ],
        "mutation_probe": "FORBIDDEN",
        "policy_introspection_with_observe_token": "FORBIDDEN_BECAUSE_API_TOKENS_READ_WOULD_EXPAND_PRIVILEGE"
      },
      "issuance_policy_attestation": {
        "required": true,
        "evidence_path": "docs/evidence/ar11-fc6-cloudflare-observe-token-policy.json",
        "must_bind_verified_token_id": true,
        "must_bind_exact_permission_names": true,
        "must_bind_exact_account_scope": true,
        "plaintext_token_forbidden": true,
        "absence_or_mismatch_decision": "UNKNOWN"
      },
      "lifecycle": [
        "issue_or_import",
        "validate",
        "bind",
        "runtime_verify",
        "rotate",
        "revoke_previous"
      ],
      "rotation_recovery_policy": "Issue a new exact-scope read-only token externally, capture metadata-only policy attestation bound to its token id, bind it write-only to staging, require accepted-main runtime verification, then revoke the previous token. On any mismatch keep mutation blocked and restore/reissue a known-good read-only token; never widen permissions as recovery.",
      "metadata_evidence": [
        "GitHub staging Environment secret-name metadata",
        "Cloudflare token active status/token id",
        "metadata-only issuance permission/resource attestation",
        "accepted-main required read-call outcomes"
      ],
      "future_cutover": "AR-11_FC6"
    }
  ],
  "readiness": {
    "allowed_decisions": [
      "READY",
      "MISSING",
      "INVALID",
      "WRONG_ENVIRONMENT",
      "WRONG_ACCOUNT",
      "WRONG_SCOPE",
      "EXCESS_CAPABILITY",
      "UNKNOWN"
    ],
    "provider_mutation_requires": "READY",
    "non_ready_provider_mutation": "FORBIDDEN",
    "evidence": "metadata-only",
    "plaintext_readback": false
  }
}
