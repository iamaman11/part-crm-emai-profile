    "implementation": "tools/opsctl/src/cli.rs",
    "active_authority_to_implementation_parity_required": true,
    "active_implementation_to_authority_parity_required": true,
    "reserved_namespaces_must_not_parse": true,
    "provider_credentials_allowed": false,
    "child_process_provider_execution_allowed": false,
    "network_provider_execution_allowed": false,
    "database_mutation_allowed": false,
    "production_mutation_allowed": false
