      "scope": "UNIQUE_PER_PROFILE_GENERATION",
      "plaintext_policy": "NO_LOG_AUDIT_SUPPORT_R2_OR_PUBLIC_METADATA",
      "raw_handle_visibility": false,
      "rotation_policy": "NEW_PROFILE_GENERATION_ONLY_NO_IN_PLACE_ENTROPY_REWRITE",
