      "legitimate_mutable_authority": "single AR-10 network/proxy credential adapter authority",
      "version_state_source": "provider/route/version/status plus non-reversible reference metadata; never raw secret handle or credential value",
      "runtime_boundary": "HANDLE_OR_SCOPED_EPHEMERAL_MATERIAL_ONLY",
