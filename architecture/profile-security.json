  "security_domains": [
    {
      "id": "profile-generation.encryption-key-hierarchy",
      "class": "CREDENTIAL_EQUIVALENT_ENVELOPE_KEY_HIERARCHY",
      "owner": "profile-key-provider-authority",
      "protected_value_authority": "KeyProviderPort-compatible protected provider; exact production provider remains unaccepted while ADR-0006 is proposed",
      "legitimate_mutable_authority": "one profile-generation root-key provider/keyring authority; no direct domain/runtime key-store mutation",
      "version_state_source": "canonical versioned root-key id plus authenticated per-generation metadata key id; no durable plaintext DEK or per-generation wrapped-key table",
      "plaintext_policy": "BOUNDED_MEMORY_ONLY_ZEROIZED_WHERE_OWNED",
      "metadata_policy": "ROOT_KEY_ID_ALGORITHM_VERSION_AND_AUTHENTICATED_GENERATION_METADATA_KEY_ID_ONLY_NO_DEK_BYTES",
      "generation_dek_policy": "DOMAIN_SEPARATED_HMAC_SHA256_DERIVATION_FROM_VERSIONED_ROOT_KEY_BOUND_TO_TENANT_PROFILE_GENERATION_AND_PLAINTEXT_DIGEST",
      "generation_nonce_policy": "SEPARATE_DOMAIN_HMAC_SHA256_DERIVATION_BOUND_TO_THE_SAME_EXACT_CONTEXT_NO_RANDOM_OR_CALLER_SELECTED_NONCE_AUTHORITY",
      "retry_policy": "EXACT_CONTEXT_REDERIVATION_IS_DETERMINISTIC_SO_PRECOMMIT_RETRY_REUSES_THE_SAME_CANDIDATE_CRYPTO_IDENTITY",
      "root_kek_overlap_model": "DUAL_READ_SINGLE_WRITE_BY_CANONICAL_ROOT_KEY_VERSION",
      "current_smoke_secret_vault_status": "ONE_DEVICE_PROTOTYPE_NOT_PRODUCTION_KEY_AUTHORITY",
      "implementation_owner": "encrypted-generation-domain owns derivation; Cloudflare generation keyring owns root-key resolution; P3 uses bounded authenticated sealing/opening material delivery; AR-13 proves rotation and AR-14 proves remote recovery",
      "production_proof_complete": false
    },
    {
      "id": "profile-identity.entropy-root",
      "class": "PROFILE_FINGERPRINT_SECRET_ROOT",
      "owner": "camoufox-profile-identity-authority",
      "protected_value_authority": "future KeyProviderPort-backed opaque profile secret handle",
      "legitimate_mutable_authority": "AR-10 profile identity creation/generation lifecycle only",
      "version_state_source": "profile generation and fingerprint policy version metadata; never entropy bytes or raw secret handle",
      "entropy_bits": 256,
      "scope": "UNIQUE_PER_PROFILE_GENERATION",
      "plaintext_policy": "NO_LOG_AUDIT_SUPPORT_R2_OR_PUBLIC_METADATA",
      "raw_handle_visibility": false,
      "rotation_policy": "NEW_PROFILE_GENERATION_ONLY_NO_IN_PLACE_ENTROPY_REWRITE",
      "implementation_owner": "AR-10",
      "production_proof_complete": false
    },
    {
      "id": "profile-bridge.device-private-key",
      "class": "DEVICE_PRIVATE_KEY",
      "owner": "profile-bridge-device-identity-authority",
      "protected_value_authority": "platform secure device-key store behind opaque key handle; production provider not yet accepted",
      "legitimate_mutable_authority": "single platform device-key adapter behind DeviceKeyPort",
      "version_state_source": "device identity/provider/key-version status; never raw key handle or private material",
      "application_boundary": "HANDLE_ONLY",
      "material_readback": false,
      "raw_handle_visibility": false,
      "primary_enrollment_use": "LOCAL_NON_EXPORTABLE_KEY_FOR_CLIENT_CERTIFICATE_CSR",
      "implementation_owner": "AR-10 supported Profile Bridge runtime integration; physical/platform key-protection proof remains a later pre-production requirement",
      "production_proof_complete": false
    },
    {
      "id": "profile-network.proxy-credential",
      "class": "TENANT_DYNAMIC_PROXY_CREDENTIAL",
      "owner": "camoufox-network-identity-adapter",
      "protected_value_authority": "approved secret-handle/provider adapter; no plaintext credential persistence in profile metadata/logs",
      "legitimate_mutable_authority": "single AR-10 network/proxy credential adapter authority",
      "version_state_source": "provider/route/version/status plus non-reversible reference metadata; never raw secret handle or credential value",
      "runtime_boundary": "HANDLE_OR_SCOPED_EPHEMERAL_MATERIAL_ONLY",
      "raw_handle_visibility": false,
      "public_model_visibility": false,
      "api_visibility": false,
      "operator_visibility": false,
      "log_audit_debug_visibility": false,
      "implementation_owner": "AR-10",
      "production_proof_complete": false
    },
    {
      "id": "profile-bridge.enrollment-claim",
      "class": "EPHEMERAL_DEVICE_ENROLLMENT_SECRET",
      "owner": "profile-bridge-enrollment-authority",
      "protected_value_authority": "bounded ephemeral claim value in the issuing/redemption flow only",
      "legitimate_mutable_authority": "single enrollment claim issue/redeem state machine",
      "version_state_source": "claim expiry/redemption/device binding metadata without claim value",
      "debug_policy": "REDACTED",
      "claim_value_visibility": "REDACTED_ONLY",
      "replay_policy": "REJECT_REPLAY_AND_DEVICE_REBIND",
      "retirement_policy": "EXPIRE_OR_SINGLE_SUCCESSFUL_REDEMPTION",
      "certificate_enrollment_scope": "ONE_LOCAL_DEVICE_KEY_ONE_CERTIFICATE_BINDING",
      "production_proof_complete": false
    },
    {
      "id": "profile-generation.short-lived-object-access",
      "class": "EPHEMERAL_SCOPED_OBJECT_ACCESS_CREDENTIAL",
      "owner": "profile-generation-object-access-issuance-authority",
      "protected_value_authority": "bounded short-lived signed PUT/GET capability delivered only after authenticated Profile/Coordinator authorization; never the static control-plane R2 pair",
      "legitimate_mutable_authority": "single scoped object-access issuer consumed by the supported Profile Bridge runtime",
      "version_state_source": "non-secret issuance reference, operation, exact object identity/digest/size binding and expiry metadata only; never bearer credential value",
      "scope_policy": "TENANT_PROFILE_GENERATION_OBJECT_OPERATION_DIGEST_SIZE_AND_EXPIRY_BOUND",
      "lifetime_policy": "SHORT_LIVED_NO_STATIC_BRIDGE_R2_CREDENTIAL",
      "redirect_policy": "DIRECT_EXACT_ENDPOINT_ONLY_NO_REDIRECT_AS_SUCCESS",
      "raw_bearer_visibility": false,
      "implementation_owner": "P3 generation upload/download capability boundary and later staging/recovery rehearsal",
      "production_proof_complete": false
    }
