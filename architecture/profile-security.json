      "public_chain_digest": "SHA256_REQUIRED",
      "associated_hostname_source": "CANONICAL_ENVIRONMENT_DEPLOYMENT_TARGET",
      "signing_material_policy": "EXTERNAL_PROTECTED_CERTIFICATE_AUTHORITY_ONLY_NO_GIT_NO_ISSUE_NO_ARTIFACT_NO_PROVIDER_PAYLOAD",
