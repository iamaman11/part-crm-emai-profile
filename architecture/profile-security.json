      "version_state_source": "device identity/public-key version/status; never raw key handle or private material",
      "application_boundary": "HANDLE_ONLY",
      "material_readback": false,
      "raw_handle_visibility": false,
      "primary_enrollment_use": "APPLICATION_DEVICE_REGISTRATION_AND_FRESH_PROOF_OF_POSSESSION",
      "implementation_owner": "shipping Windows Profile Bridge native device-key adapter",
      "production_proof_complete": false
    },
    {
