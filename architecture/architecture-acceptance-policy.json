    "derived_current_slice_match_required": true
  },
  "merge": {
    "expected_head_sha_binding_required": true,
    "accepted_main_reread_required": true,
    "candidate_tree_equals_merge_tree_required": true,
    "merge_first_parent_equals_premerge_base_required": true
  },
  "required_status_contexts": {
