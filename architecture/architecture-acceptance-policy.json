    "head_branch_shape": "agent/arN-*"
  },
  "premerge": {
    "exact_head_required": true,
    "behind_by_required": 0,
    "blocking_reviews_required": 0,
    "unresolved_review_threads_required": 0,
    "all_applicable_permanent_workflows_success": true,
