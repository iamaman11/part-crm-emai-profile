    "duplicate_contexts_forbidden": true,
    "all_must_succeed_on_exact_candidate": true
  },
  "applicable_permanent_workflows": {
    "registry": "architecture/github-actions-registry.json",
    "category": "PERMANENT_REQUIRED",
    "applicability_rule": "canonical workflow declares pull_request trigger",
    "every_applicable_workflow_must_have_exact_candidate_run": true,
    "all_must_succeed_on_exact_candidate": true,
    "missing_run_fails_closed": true
  },
  "acceptance_metadata": {
    "storage": "annotated_git_tag",
    "namespace": "architecture/accepted/",
    "tag_target": "accepted_main_merge_commit",
    "append_only": true,
    "force_move_allowed": false,
    "delete_allowed": false,
    "source_commit_required": false,
    "source_commit_forbidden_for_acceptance_only": true,
    "tag_required_from": "AR-12",
    "record_schema_version": 1,
    "required_fields": [
      "slice",
      "pr",
      "base_sha",
      "candidate_sha",
      "candidate_tree",
      "merge_sha",
      "merge_tree",
      "required_status_contexts_total",
