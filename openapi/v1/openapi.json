{
  "openapi": "3.1.0",
  "info": {
    "title": "Browser Profile Control Plane API",
    "version": "1.0.0",
    "description": "Versioned control-plane contracts for health, authenticated tenant identity, clients, profiles and explicit ACL management."
  },
  "servers": [
    {
      "url": "https://control.example.invalid"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalFailure"
          }
        }
      }
    },
    "/api/v1/session": {
      "get": {
        "operationId": "getAuthenticatedSession",
        "security": [
          {
            "cloudflareAccessJwt": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantHeader"
          },
          {
            "$ref": "#/components/parameters/CorrelationHeader"
          }
        ],
        "responses": {
          "200": {
            "description": "Verified identity resolved to an active tenant membership",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActorSession"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NeutralNotFound"
          }
        }
      }
    },
    "/api/v1/tenants/{tenantId}/owner/bootstrap": {
      "post": {
        "operationId": "bootstrapTenantOwner",
        "security": [
          {
            "cloudflareAccessJwt": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantPath"
          },
          {
            "$ref": "#/components/parameters/CorrelationHeader"
          },
          {
            "$ref": "#/components/parameters/IdempotencyHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OwnerBootstrapRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing idempotent owner bootstrap result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MutationReceipt"
                }
              }
            }
          },
          "201": {
            "description": "Owner bootstrapped for an empty tenant boundary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MutationReceipt"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/api/v1/tenants/{tenantId}/owner/transfer": {
      "post": {
