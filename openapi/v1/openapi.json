              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MutationReceipt"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NeutralNotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      },
      "delete": {
        "operationId": "revokeClientAccess",
        "security": [
          {
            "cloudflareAccessJwt": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantPath"
          },
          {
            "$ref": "#/components/parameters/ClientPath"
          },
          {
            "$ref": "#/components/parameters/ActorPath"
          },
          {
            "$ref": "#/components/parameters/CorrelationHeader"
          },
          {
            "$ref": "#/components/parameters/IdempotencyHeader"
          }
        ],
        "responses": {
          "204": {
            "description": "Explicit client grant revoked"
          },
          "404": {
            "$ref": "#/components/responses/NeutralNotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/api/v1/tenants/{tenantId}/profiles": {
      "post": {
        "operationId": "createProfileMetadata",
