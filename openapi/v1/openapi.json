{
  "openapi": "3.1.0",
  "info": {
    "title": "Browser Profile Control Plane API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Control plane process is available",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "correlation_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 96
          }
        }
      }
    }
  }
}
