  },
  "components": {
    "securitySchemes": {
      "cloudflareAccessJwt": {
        "type": "apiKey",
        "in": "header",
        "name": "Cf-Access-Jwt-Assertion",
        "description": "Cloudflare Access JWT verified by the Worker identity adapter."
      }
    },
    "parameters": {
      "TenantHeader": {
        "name": "X-Tenant-Id",
        "in": "header",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/OpaqueId"
        }
      },
      "CorrelationHeader": {
        "name": "X-Correlation-Id",
        "in": "header",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/OpaqueId"
        }
      },
      "IdempotencyHeader": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/OpaqueId"
        }
      },
      "TenantPath": {
        "name": "tenantId",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/OpaqueId"
        }
      },
      "ActorPath": {
        "name": "actorId",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/OpaqueId"
        }
      },
      "InvitationPath": {
        "name": "invitationId",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/OpaqueId"
        }
      },
      "ClientPath": {
        "name": "clientId",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/OpaqueId"
        }
      },
      "ProfilePath": {
        "name": "profileId",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/OpaqueId"
        }
      }
    },
    "responses": {
      "NeutralNotFound": {
        "description": "Missing, foreign or unauthorized resource; disclosure-neutral shape",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Conflict": {
        "description": "Optimistic version, idempotency or state conflict",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "InternalFailure": {
        "description": "Internal failure",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "OpaqueId": {
        "type": "string",
        "minLength": 8,
        "maxLength": 96,
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "AggregateVersion": {
        "type": "integer",
        "minimum": 1
      },
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "contractVersion"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "contractVersion": {
            "type": "string",
            "const": "v1"
          }
        }
      },
      "ActorSession": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tenantId",
          "actorId",
          "role"
        ],
        "properties": {
          "tenantId": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "actorId": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "role": {
            "type": "string",
            "enum": [
              "TENANT_OWNER",
              "MEMBER"
            ]
          }
        }
      },
      "MutationReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resultCode",
          "resourceId",
          "aggregateVersion"
        ],
        "properties": {
          "resultCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "resourceId": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "aggregateVersion": {
            "$ref": "#/components/schemas/AggregateVersion"
          }
        }
      },
      "OwnerBootstrapRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actorId",
          "identityId",
          "tenantDisplayName",
          "requestDigest"
        ],
        "properties": {
          "actorId": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "identityId": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "tenantDisplayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "requestDigest": {
            "type": "string",
            "minLength": 16,
            "maxLength": 256
          }
        }
      },
      "OwnerTransferRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nextOwnerActorId",
          "currentOwnerVersion",
          "nextOwnerVersion",
          "requestDigest"
        ],
        "properties": {
          "nextOwnerActorId": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "currentOwnerVersion": {
            "$ref": "#/components/schemas/AggregateVersion"
          },
          "nextOwnerVersion": {
            "$ref": "#/components/schemas/AggregateVersion"
          },
          "requestDigest": {
            "type": "string",
            "minLength": 16,
            "maxLength": 256
          }
        }
      },
      "InvitationCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "invitationId",
          "invitedContactHmac",
          "expiresAtMs",
          "expectedTenantVersion",
          "requestDigest"
        ],
        "properties": {
          "invitationId": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "invitedContactHmac": {
            "type": "string",
            "minLength": 16,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "expiresAtMs": {
            "type": "integer",
            "minimum": 0
          },
          "expectedTenantVersion": {
            "$ref": "#/components/schemas/AggregateVersion"
          },
          "requestDigest": {
            "type": "string",
            "minLength": 16,
            "maxLength": 256
          }
        }
      },
      "InvitationAcceptRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identityId",
          "actorId",
          "requestDigest"
        ],
        "properties": {
          "identityId": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "actorId": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "requestDigest": {
            "type": "string",
            "minLength": 16,
            "maxLength": 256
          }
        }
      },
