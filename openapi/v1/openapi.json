          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantPath"
          },
          {
            "$ref": "#/components/parameters/CorrelationHeader"
          },
          {
            "$ref": "#/components/parameters/IdempotencyHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Profile metadata created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MutationReceipt"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NeutralNotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/api/v1/tenants/{tenantId}/profiles/{profileId}": {
      "get": {
        "operationId": "getProfileMetadata",
        "security": [
          {
            "cloudflareAccessJwt": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantPath"
          },
          {
            "$ref": "#/components/parameters/ProfilePath"
          },
          {
            "$ref": "#/components/parameters/CorrelationHeader"
          }
        ],
        "responses": {
          "200": {
            "description": "Tenant-scoped profile visible to owner or explicitly granted member",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileView"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NeutralNotFound"
          }
        }
      }
    },
    "/api/v1/tenants/{tenantId}/profiles/{profileId}/assignment": {
      "put": {
        "operationId": "assignProfileToClient",
        "security": [
          {
            "cloudflareAccessJwt": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantPath"
          },
          {
            "$ref": "#/components/parameters/ProfilePath"
          },
          {
            "$ref": "#/components/parameters/CorrelationHeader"
          },
          {
            "$ref": "#/components/parameters/IdempotencyHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssignmentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Historical profile/client assignment updated without changing authorization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MutationReceipt"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NeutralNotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/api/v1/tenants/{tenantId}/profiles/{profileId}/grants/{actorId}": {
      "put": {
        "operationId": "grantProfileAccess",
