# ==============================================================================
# Camoufox Anti-Detect Browser Profile Lifecycle Management - .gitignore
# ==============================================================================

# Private Browser Profiles & Cookies (CRITICAL: EXCLUDE ALL SESSION DATA)
browser_profiles/
temp/
state/
artifacts/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
*.bin
*.lz4
lock
.parentlock

# Rust build outputs
/target/

# Frontend dependency and build outputs
/frontend/node_modules/
/frontend/dist/
/frontend/coverage/
/frontend/*.tsbuildinfo

# Secrets & Environment Variables
.env
.env.*
.dev.vars
.dev.vars.*
*.pem
*.key
/deploy/cloudflare/manifests/
/deploy/cloudflare/generated/

# Python Virtual Environment & Bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/

# IDE & Editor Settings
.idea/
.vscode/
*.swp
*.swo

# Logs & Temporary Files
*.log
scratch/
