{
  "name": "mailbox-secret-resolver",
  "main": "../../apps/mailbox-secret-resolver-worker/build/worker/shim.mjs",
  "compatibility_date": "2026-08-05",
  "workers_dev": false,
  "build": {
    "command": "cargo install worker-build --version 0.8.5 --locked && worker-build --release",
    "cwd": "../../apps/mailbox-secret-resolver-worker"
  },
  "env": {
    "staging": {
      "name": "mailbox-secret-resolver-staging",
      "account_id": "${STAGING_ACCOUNT_ID}",
      "workers_dev": false,
      "routes": [],
      "vars": {
        "GOOGLE_OAUTH_CLIENT_ID": "${STAGING_GOOGLE_OAUTH_CLIENT_ID}",
        "GOOGLE_OAUTH_REDIRECT_URI": "${STAGING_GOOGLE_OAUTH_REDIRECT_URI}",
        "MICROSOFT_OAUTH_CLIENT_ID": "${STAGING_MICROSOFT_OAUTH_CLIENT_ID}",
        "MICROSOFT_OAUTH_REDIRECT_URI": "${STAGING_MICROSOFT_OAUTH_REDIRECT_URI}"
      },
      "secrets": {
        "required": [
          "GOOGLE_OAUTH_CLIENT_SECRET",
          "MAILBOX_RESOLVER_CALLER_AUTH_KEY",
          "MAILBOX_RESOLVER_ENCRYPTION_KEYRING",
          "MAILBOX_RESOLVER_HANDLE_HMAC_KEY",
          "MICROSOFT_OAUTH_CLIENT_SECRET"
        ]
      },
      "d1_databases": [
        {
          "binding": "RESOLVER_DB",
          "database_name": "${STAGING_RESOLVER_D1_DATABASE_NAME}",
          "database_id": "${STAGING_RESOLVER_D1_DATABASE_ID}",
          "migrations_dir": "../../migrations/resolver-d1"
        }
      ]
    },
    "production": {
      "name": "mailbox-secret-resolver-production",
      "account_id": "${PRODUCTION_ACCOUNT_ID}",
      "workers_dev": false,
      "routes": [],
      "vars": {
        "GOOGLE_OAUTH_CLIENT_ID": "${PRODUCTION_GOOGLE_OAUTH_CLIENT_ID}",
        "GOOGLE_OAUTH_REDIRECT_URI": "${PRODUCTION_GOOGLE_OAUTH_REDIRECT_URI}",
        "MICROSOFT_OAUTH_CLIENT_ID": "${PRODUCTION_MICROSOFT_OAUTH_CLIENT_ID}",
        "MICROSOFT_OAUTH_REDIRECT_URI": "${PRODUCTION_MICROSOFT_OAUTH_REDIRECT_URI}"
      },
      "secrets": {
        "required": [
          "GOOGLE_OAUTH_CLIENT_SECRET",
          "MAILBOX_RESOLVER_CALLER_AUTH_KEY",
          "MAILBOX_RESOLVER_ENCRYPTION_KEYRING",
          "MAILBOX_RESOLVER_HANDLE_HMAC_KEY",
          "MICROSOFT_OAUTH_CLIENT_SECRET"
        ]
      },
      "d1_databases": [
        {
          "binding": "RESOLVER_DB",
          "database_name": "${PRODUCTION_RESOLVER_D1_DATABASE_NAME}",
          "database_id": "${PRODUCTION_RESOLVER_D1_DATABASE_ID}",
          "migrations_dir": "../../migrations/resolver-d1"
        }
      ]
    }
  }
}
